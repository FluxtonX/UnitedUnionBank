{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    "max-len": "off",
    "object-curly-spacing": "off",
    "comma-dangle": "off",
    "quotes": ["error", "double"],
    "semi": ["error", "always"]
  }
}
