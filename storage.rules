rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdminOrCompliance() {
      return hasRole('admin') || hasRole('compliance');
    }

    function validKycUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /kyc/{uid}/{caseId}/{fileName} {
      allow read: if isOwner(uid) || isAdminOrCompliance();
      allow create: if isOwner(uid) && validKycUpload();
      allow update, delete: if false;
    }

    match /projects/{projectId}/{fileName} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /profile_images/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdminOrCompliance();
      allow create: if isOwner(uid)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
